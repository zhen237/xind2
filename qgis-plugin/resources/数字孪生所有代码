        Vector3 centerPos = (center != null) ? center.position : Vector3.zero;

        // 绕中心点水平旋转，并始终看向中心
        transform.RotateAround(centerPos, Vector3.up, speed * Time.deltaTime);
        transform.LookAt(centerPos);
    }
