public class canvastop : MonoBehaviour
{
    [Header("Text 引用（自动查找，也可手动拖）")]
    private Text timeText;
    private Text dateText;
    private Text locationText;
    private Text weatherText;
    private Text temText;
    private Text airText;

    [Header("高德天气 API")]
    private string apiKey = "5f05f2f6ab69de6ff29b5722c2ef23c2";
    private string cityCode = "140105"; // 太原市小店区
    private string apiUrl;

    void Start()
    {
        // 查找所有 Text 物体
        timeText     = GameObject.Find("time")?.GetComponent<Text>();
        dateText     = GameObject.Find("date")?.GetComponent<Text>();
        locationText = GameObject.Find("location")?.GetComponent<Text>();
        weatherText  = GameObject.Find("weather")?.GetComponent<Text>();
        temText      = GameObject.Find("tem")?.GetComponent<Text>();
        airText      = GameObject.Find("air")?.GetComponent<Text>();

        if (timeText     == null) Debug.LogError("找不到 time Text");
        if (dateText     == null) Debug.LogError("找不到 date Text");
        if (locationText == null) Debug.LogError("找不到 location Text");
        if (weatherText  == null) Debug.LogError("找不到 weather Text");
        if (temText      == null) Debug.LogError("找不到 tem Text");
        if (airText      == null) Debug.LogError("找不到 air Text");

        apiUrl = $"https://restapi.amap.com/v3/weather/weatherInfo?city={cityCode}&key={apiKey}";

        // 启动时钟（每秒）和天气（每5分钟）
        StartCoroutine(ClockRoutine());
        StartCoroutine(WeatherRoutine());
    }

    // ========== 时钟 ==========

    IEnumerator ClockRoutine()
    {
        while (true)
        {
            System.DateTime now = System.DateTime.Now;

            if (timeText != null)
                timeText.text = now.ToString("HH:mm:ss");

            if (dateText != null)
                dateText.text = now.ToString("yyyy/MM/dd");

            yield return new WaitForSeconds(1f);
        }
    }

    // ========== 天气 ==========

    IEnumerator WeatherRoutine()
    {
        while (true)
        {
            yield return FetchWeather();
            yield return new WaitForSeconds(300f); // 5 分钟刷新一次
        }
    }

    IEnumerator FetchWeather()
    {
        using (UnityWebRequest req = UnityWebRequest.Get(apiUrl))
        {
            req.timeout = 10;
            yield return req.SendWebRequest();

            if (req.result != UnityWebRequest.Result.Success)
            {
                Debug.LogError("天气 API 请求失败: " + req.error);
                yield break;
            }

            string json = req.downloadHandler.text;
            ParseWeatherJson(json);
        }
    }

    void ParseWeatherJson(string json)
    {
        Debug.Log("天气 API 原始返回: " + json);

        var root = JsonUtility.FromJson<AmapWeatherRoot>(json);

        if (root.status != "1" || root.lives == null || root.lives.Length == 0)
        {
            Debug.LogError("天气数据异常: " + json);
            return;
        }

        var live = root.lives[0];
        Debug.Log($"解析结果 -> 省份:{live.province} 城市:{live.city} 天气:{live.weather} 温度:{live.temperature} 湿度:{live.humidity}");

        if (locationText != null)
            locationText.text = $"{live.province} {live.city}";

        if (weatherText != null)
            weatherText.text = live.weather;

        // 温度 —— 去掉°C符号，防止字体问题
        if (temText != null && !string.IsNullOrEmpty(live.temperature))
            temText.text = live.temperature + "℃";
        else if (temText != null)
            temText.text = "--℃";

        if (airText != null)
            airText.text = $"湿度 {live.humidity}%";
    }
}

