public class canvastopbutton : MonoBehaviour
{
    [Header("按钮选中时的文字颜色")]
    public Color activeColor = Color.white;

    private GameObject[] panels = new GameObject[7];
    private Button[] buttons = new Button[7];
    private Color[] defaultColors = new Color[7];
    private GameObject[] indicators = new GameObject[7];
    private int currentIndex = 1;

    void Start()
    {
        // 确保 EventSystem 存在（没有它 UI 按钮点不动！）
        if (Object.FindObjectOfType<EventSystem>() == null)
        {
            var es = new GameObject("EventSystem", typeof(EventSystem), typeof(StandaloneInputModule));
            Debug.Log("场景缺少 EventSystem，已自动创建");
        }

        // ========== 调试：打印所有激活物体的名字 ==========
        Debug.Log("===== 场景中所有激活物体 =====");
        foreach (GameObject go in Object.FindObjectsOfType<GameObject>())
        {
            if (go.activeInHierarchy && go.transform.parent == null)
                Debug.Log("物体: " + go.name);
        }
        Debug.Log("===== 本物体(Canvastop)的子物体 =====");
        for (int i = 0; i < transform.childCount; i++)
            Debug.Log("子物体 " + i + ": " + transform.GetChild(i).name);
        // ========================================

        // 缓存面板
        for (int i = 1; i <= 6; i++)
            panels[i] = GameObject.Find("Canvasright" + i);

        // 缓存按钮、默认颜色、指示器，并绑定点击
        for (int i = 1; i <= 6; i++)
        {
            GameObject btnObj = GameObject.Find("Button" + i);
            if (btnObj == null)
            {
                Debug.LogWarning("找不到 Button" + i);
                continue;
            }

            Button btn = btnObj.GetComponent<Button>();
            if (btn == null) continue;
            buttons[i] = btn;

            // 第一个子物体 → Text（兼容 TMP 和 旧版 Text）
            Transform child0 = btnObj.transform.GetChild(0);
            TextMeshProUGUI tmp = child0.GetComponent<TextMeshProUGUI>();
            Text legacy = child0.GetComponent<Text>();
            if (tmp != null)
            {
                defaultColors[i] = tmp.color;
                Debug.Log($"Button{i} 子物体0 = {child0.name} (TMP)");
            }
            else if (legacy != null)
            {
                defaultColors[i] = legacy.color;
                Debug.Log($"Button{i} 子物体0 = {child0.name} (Legacy Text)");
            }
            else
            {
                Debug.LogWarning($"Button{i} 第一个子物体 {child0.name} 没有 Text 组件");
            }

            // 第二个子物体 → 指示器
            if (btnObj.transform.childCount >= 2)
            {
                indicators[i] = btnObj.transform.GetChild(1).gameObject;
                Debug.Log($"Button{i} 第二个子物体 = {btnObj.transform.GetChild(1).name}");
            }
            else
            {
                Debug.LogWarning($"Button{i} 没有第二个子物体");
            }

            int idx = i;
            btn.onClick.AddListener(() => SwitchTo(idx));
        }

        // 默认选中 Button1
        SwitchTo(1);
    }

    void SwitchTo(int activeIndex)
    {
        // 恢复上一个按钮
        SetButtonSelected(currentIndex, false);

        // 激活新按钮
        SetButtonSelected(activeIndex, true);

        // 切换面板
        for (int i = 1; i <= 6; i++)
        {
            if (panels[i] != null)
                panels[i].SetActive(i == activeIndex);
        }

        currentIndex = activeIndex;
    }

    void SetButtonSelected(int idx, bool selected)
    {
        if (buttons[idx] == null) return;

        // 第一个子物体 → Text 颜色（兼容 TMP 和 旧版 Text）
        Transform child0 = buttons[idx].transform.GetChild(0);
        TextMeshProUGUI tmp = child0.GetComponent<TextMeshProUGUI>();
        Text legacy = child0.GetComponent<Text>();

        if (tmp != null)
            tmp.color = selected ? activeColor : defaultColors[idx];
        else if (legacy != null)
            legacy.color = selected ? activeColor : defaultColors[idx];

        // 第二个子物体 → 指示器显隐
        if (indicators[idx] != null)
            indicators[idx].SetActive(selected);
    }
}
