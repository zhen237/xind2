public class CameraSpin : MonoBehaviour
{
    [Header("旋转中心（空 = 绕世界原点）")]
    public Transform center;

    [Header("旋转速度（度/秒，数值越小越慢）")]
    public float speed = 8f;

    [Header("按空格键暂停/继续")]
    public bool paused = false;

    void Update()
    {
        if (Input.GetKeyDown(KeyCode.Space))
            paused = !paused;

