public class CameraOrbitControl : MonoBehaviour
{
    [Header("旋转中心（空 = 世界原点）")]
    public Transform center;

    [Header("空闲自动旋转速度（度/秒）")]
    public float autoSpeed = 8f;

    [Header("手动操作灵敏度")]
    public float dragSpeed = 0.3f;

    [Header("滚轮缩放速度")]
    public float zoomSpeed = 2f;

    [Header("停止操作后多久恢复自动旋转（秒）")]
    public float resumeDelay = 2f;

    private Vector3 orbitPoint;   // 虚拟旋转中心
    private float idleTime = 0f;  // 空闲计时
    private bool wasOperating = false;

    void Start()
    {
        orbitPoint = (center != null) ? center.position : Vector3.zero;
        transform.LookAt(orbitPoint);
    }

    void Update()
    {
        // ===== 检测鼠标是否在操作 =====
        bool operating = Input.GetMouseButton(0) || Input.GetMouseButton(1) || Input.GetMouseButton(2)
                       || Input.GetAxis("Mouse ScrollWheel") != 0f;

        if (operating)
        {
            idleTime = 0f;
            wasOperating = true;
            HandleManual();
        }
        else
        {
            if (wasOperating)
            {
                idleTime += Time.deltaTime;
                if (idleTime >= resumeDelay) wasOperating = false;
            }
            else
            {
                AutoSpin();
            }
        }
    }

    // ===== 空闲时：自动缓慢旋转 =====
    void AutoSpin()
    {
        transform.RotateAround(orbitPoint, Vector3.up, autoSpeed * Time.deltaTime);
        transform.LookAt(orbitPoint);
    }

    // ===== 鼠标操作时：手动控制 =====
    void HandleManual()
    {
        float dx = Input.GetAxis("Mouse X");
        float dy = Input.GetAxis("Mouse Y");
        float dist = Vector3.Distance(transform.position, orbitPoint);

        // 左键：拖动旋转视角（像 3D 查看器）
        if (Input.GetMouseButton(0))
        {
            transform.RotateAround(orbitPoint, Vector3.up, dx * dragSpeed * 10f);
            transform.RotateAround(orbitPoint, transform.right, -dy * dragSpeed * 10f);
            transform.LookAt(orbitPoint);
        }

        // 右键：平移场景视角
        if (Input.GetMouseButton(1))
        {
            Vector3 right = transform.right;
            Vector3 up = transform.up;
            float moveScale = dist * 0.0015f;
            Vector3 offset = (-right * dx + -up * dy) * moveScale;
            transform.position += offset;
            orbitPoint += offset;
        }

        // 滚轮：缩放（拉近拉远）
        float scroll = Input.GetAxis("Mouse ScrollWheel");
        if (scroll != 0f)
        {
            Vector3 dir = (transform.position - orbitPoint).normalized;
            dist = Mathf.Clamp(dist - scroll * zoomSpeed * 5f, 3f, 200f);
            transform.position = orbitPoint + dir * dist;
        }
    }
}
