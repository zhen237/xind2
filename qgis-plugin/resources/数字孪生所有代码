/// <summary>
/// 点击 anquanmaobutton：视角切换到人物头上（第一人称）+ 人物停止运动
/// 挂到任意物体上，自动绑定按钮
/// </summary>
public class SwitchToHeadView : MonoBehaviour
{
    [Header("人物（空 = 自动找 Character）")]
    public GameObject character;

    [Header("头部高度（从人物脚底向上算）")]
    public float headHeight = 1.7f;

    [Header("人物是否还朝看向方向移动")]
    public bool stopCharacter = true;

    void Start()
    {
        // 自动找人物
        if (character == null)
            character = GameObject.Find("Character");

        // 自动绑定按钮
        GameObject btn = GameObject.Find("anquanmaobutton");
        if (btn != null && btn.GetComponent<Button>() != null)
        {
            btn.GetComponent<Button>().onClick.AddListener(SwitchView);
            Debug.Log("[视角切换] 已绑定 anquanmaobutton");
        }
        else
        {
            Debug.LogWarning("[视角切换] 找不到 anquanmaobutton 按钮！");
        }
    }

    void SwitchView()
    {
        if (character == null)
        {
            Debug.LogError("[视角切换] 找不到人物 Character！");
            return;
        }

        // 1. 停止人物运动
        if (stopCharacter)
        {
            var walk = character.GetComponent<WalkBackForth>();
            if (walk != null)
                walk.enabled = false;
            Debug.Log("[视角切换] 人物已停止运动");
        }

        // 2. 停掉相机自动旋转
        var orbit = GetComponent<CameraOrbitControl>();
        if (orbit != null)
            orbit.enabled = false;
        var spin = GetComponent<CameraSpin>();
        if (spin != null)
            spin.enabled = false;

        // 3. 相机切到人物头上，朝人物朝向看
        Camera cam = Camera.main;
        if (cam == null)
            cam = Object.FindObjectOfType<Camera>();
        if (cam == null)
        {
            Debug.LogError("[视角切换] 找不到相机！");
            return;
        }

        cam.transform.position = character.transform.position + Vector3.up * headHeight;
        cam.transform.rotation = character.transform.rotation;
        Debug.Log($"[视角切换] 相机已移到 {character.name} 头上（高度 {headHeight}）");
    }
}
using UnityEngine;

public class WalkBackForth : MonoBehaviour
{
    [Header("行走速度")]
    public float speed = 2f;

    [Header("来回距离（米）")]
    public float range = 5f;

    [Header("走到端点停留时间（秒）")]
    public float pauseTime = 1f;

    [Header("勾选 = 2D 翻转(Scale)，不勾 = 3D 转身(Rotation)")]
    public bool flipByScale = false;

    private Vector3 startPos;
    private int dir = 1;
    private float pauseLeft = 0f;

    void Start()
    {
        startPos = transform.position;
    }

    void Update()
    {
        // 端点停留
        if (pauseLeft > 0f)
        {
            pauseLeft -= Time.deltaTime;
            return;
        }

        Vector3 pos = transform.position;
        pos.x += speed * dir * Time.deltaTime;

        // 到达端点 → 转向
        if (dir > 0 && pos.x - startPos.x >= range)
        {
            pos.x = startPos.x + range;
            dir = -1;
            pauseLeft = pauseTime;
            Flip();
        }
        else if (dir < 0 && pos.x - startPos.x <= -range)
        {
            pos.x = startPos.x - range;
            dir = 1;
            pauseLeft = pauseTime;
            Flip();
        }

        transform.position = pos;
    }

    void Flip()
    {
        if (flipByScale)
        {
            // 2D：翻转 Scale X
            Vector3 s = transform.localScale;
            s.x = dir * Mathf.Abs(s.x);
            transform.localScale = s;
        }
        else
        {
            // 3D：转身 180°
            transform.Rotate(0f, 180f, 0f);
        }
    }
}
