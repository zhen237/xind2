/// <summary>
/// 闪烁效果 — 让 Image 周期性明暗交替
/// 挂到 zuobiaoImage 上即可
/// </summary>
public class BlinkEffect : MonoBehaviour
{
    [Header("闪烁速度（次数/秒，数值越大闪越快）")]
    public float blinkSpeed = 2f;

    [Header("最暗时透明度（0 = 完全消失）")]
    public float minAlpha = 0f;

    [Header("最亮时透明度（1 = 不透明）")]
    public float maxAlpha = 1f;

    private Image img;

    void Start()
    {
        img = GetComponent<Image>();
        if (img == null)
            Debug.LogWarning("[闪烁] " + gameObject.name + " 上没有 Image 组件！");
    }

    void Update()
    {
        if (img == null) return;

        // 正弦波控制透明度：0→1→0 循环
        float t = (Mathf.Sin(Time.time * blinkSpeed * Mathf.PI * 2f) + 1f) * 0.5f;
        float a = Mathf.Lerp(minAlpha, maxAlpha, t);

        Color c = img.color;
        c.a = a;
        img.color = c;
    }
}
