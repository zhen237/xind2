/// <summary>
/// 通信基站违章报警 — 自动创建报警框，字幕滚动，违章行标红
/// 挂到任意物体（如 Canvastop）上，运行后自动创建
/// </summary>
public class weizhangbaojing : MonoBehaviour
{
    [Header("违章文案（每行一条，用回车分隔）")]
    [TextArea(5, 15)]
    public string alarmText =
        "2026-08-11 08:00:01 基站A 塔高 52m 超标\n" +
        "2026-08-11 08:05:33 基站B 离居民区距离 28m 不足\n" +
        "2026-08-11 08:10:47 基站C 电磁辐射合规\n" +
        "2026-08-11 08:15:02 基站D 未办理建设手续\n" +
        "2026-08-11 08:20:18 基站E 选址合规\n" +
        "2026-08-11 08:25:41 基站F 天线高度违规";

    [Header("违章关键词（含这些词的行标红）")]
    public string[] errorKeywords = { "超标", "不足", "未办理", "违规" };

    [Header("报警框尺寸")]
    public float boxWidth = 400f;
    public float boxHeight = 220f;

    [Header("报警框位置（屏幕坐标，中心点）")]
    public float boxPosX = 0f;
    public float boxPosY = 0f;

    [Header("滚动速度（像素/秒）")]
    public float scrollSpeed = 40f;

    [Header("字号")]
    public int fontSize = 22;

    private Text scrollText;
    private RectTransform scrollRect;
    private RectTransform boxRect;
    private float contentHeight;

    void Start()
    {
        // ===== 1. 找父 Canvas =====
        Canvas canvas = GetComponentInParent<Canvas>();
        if (canvas == null)
            canvas = Object.FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.LogError("[违章报警] 场景里没有 Canvas！");
            return;
        }

        // ===== 2. 创建报警框（背景 + 裁剪） =====
        var boxGo = new GameObject("违章报警框", typeof(RectTransform), typeof(Image), typeof(RectMask2D));
        boxGo.transform.SetParent(canvas.transform, false);
        boxRect = boxGo.GetComponent<RectTransform>();
        boxRect.sizeDelta = new Vector2(boxWidth, boxHeight);
        boxRect.anchoredPosition = new Vector2(boxPosX, boxPosY);

        Image bg = boxGo.GetComponent<Image>();
        bg.color = new Color(0f, 0f, 0f, 0.6f); // 半透明黑底

        // ===== 3. 创建滚动文字（铺满框） =====
        var go = new GameObject("滚动内容", typeof(RectTransform), typeof(Text));
        go.transform.SetParent(boxGo.transform, false);
        scrollRect = go.GetComponent<RectTransform>();
        scrollRect.anchorMin = Vector2.zero;
        scrollRect.anchorMax = Vector2.one;
        scrollRect.offsetMin = Vector2.zero;
        scrollRect.offsetMax = Vector2.zero;

        scrollText = go.GetComponent<Text>();

        // 加载字体：优先微软雅黑，失败再试内置字体
        Font font = Font.CreateDynamicFontFromOSFont("Microsoft YaHei", fontSize);
        if (font == null) font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        if (font == null) font = Resources.GetBuiltinResource<Font>("Arial.ttf");
        if (font == null) Debug.LogError("[违章报警] 所有字体都加载失败！");
        scrollText.font = font;
        scrollText.fontSize = fontSize;
        scrollText.supportRichText = true;
        scrollText.verticalOverflow = VerticalWrapMode.Overflow;
        scrollText.horizontalOverflow = HorizontalWrapMode.Overflow;
        scrollText.alignment = TextAnchor.UpperLeft;
        scrollText.color = Color.white;

        // ===== 4. 组装文案：违章行标红 =====
        string[] lines = alarmText.Split('\n');
        StringBuilder sb = new StringBuilder();
        foreach (string line in lines)
        {
            bool isError = false;
            foreach (string kw in errorKeywords)
            {
                if (line.Contains(kw)) { isError = true; break; }
            }
            if (isError)
                sb.AppendLine("<color=#FF0000>" + line + "</color>");
            else
                sb.AppendLine(line);
        }
        scrollText.text = sb.ToString();

        contentHeight = scrollText.preferredHeight;
        Debug.Log($"[违章报警] 已创建：框={boxWidth}x{boxHeight} 内容={scrollText.text.Length}字 内容高={contentHeight}");

        // ===== 5. 初始位置：从框底开始 =====
        scrollRect.anchoredPosition = new Vector2(0, -boxRect.rect.height * 0.5f);
    }

    void Update()
    {
        if (scrollRect == null) return;

        // 向上滚动
        float y = scrollRect.anchoredPosition.y + scrollSpeed * Time.deltaTime;

        // 全部滚出框顶 → 回到框底，循环
        if (y > boxRect.rect.height * 0.5f + contentHeight)
            y = -boxRect.rect.height * 0.5f;

        scrollRect.anchoredPosition = new Vector2(0, y);
    }
}

