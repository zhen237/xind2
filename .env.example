# ============================================
# 通信基建数智化全流程平台 — 环境变量模板
# 使用方法: cp .env.example .env
# ============================================

# --- MySQL 数据库 ---
MYSQL_URL=jdbc:mysql://localhost:3306/comm_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
MYSQL_USER=root
MYSQL_PASSWORD=root123

# --- JWT 认证 ---
JWT_SECRET=please-change-this-to-a-strong-random-secret-in-production
JWT_EXPIRATION=604800000

# --- MinIO 对象存储 ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- EMQX MQTT ---
MQTT_BROKER=tcp://localhost:1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public

# --- Redis (Phase 3c 启用) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- InfluxDB (M05 遥测) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-token
INFLUXDB_ORG=comm
INFLUXDB_BUCKET=telemetry

# --- 服务端口 ---
M01_PORT=8080
M03_PORT=8083
M04_PORT=8084
M05_PORT=8085
SCREEN_PORT=8087

# --- Docker MinIO (init) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
