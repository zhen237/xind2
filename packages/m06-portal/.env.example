# ============================================================
# M06-Portal 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================================

# 后端API地址
VITE_API_M01=http://localhost:8080
VITE_API_M05=http://localhost:8085

# 子模块前端地址（iframe 嵌入用）
VITE_FE_M01=http://localhost:8080
VITE_FE_M02=http://localhost:8081
VITE_FE_M03=http://localhost:5174/modules/m03
VITE_FE_M04=http://localhost:5175
VITE_FE_M05=http://localhost:8085

# 新赛题模块前端地址（留空则自动回退到 m04，配置后切换到新模块）
VITE_FE_S2=http://localhost:5182
VITE_FE_S3=http://localhost:5189
VITE_FE_S4=http://localhost:5190
VITE_FE_S5=http://localhost:5191

# m03(S1 智能设计) 内部接口 X-API-Key：/api/m03/design/** 的 GET 需携带
# 与 m03 后端 m03.api-key 默认值一致（dev: CHANGE_ME），生产请改真实值
VITE_M03_API_KEY=CHANGE_ME

# Cesium 地图服务 Token（⚠️ 敏感信息，切勿提交）
VITE_TIANDITU_TOKEN=your_tianditu_token_here
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here