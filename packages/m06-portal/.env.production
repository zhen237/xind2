# 生产环境 —— 子模块前端地址（同源相对路径）
# 服务器上所有模块前端都在 /www/wwwroot/portal/modules/ 下
# portal 通过 nginx 同源提供这些文件，iframe 用相对路径加载

# S1 智能设计 (M03)
VITE_FE_M03=/modules/m03

# S4 数智交付 (M04)
VITE_FE_M04=/modules/m04

# 其他模块（暂未部署，留空或指向同源）
VITE_FE_M01=/modules/m01
VITE_FE_M02=/modules/m02
VITE_FE_M05=/modules/m05

# ⚠️ 必填：S2~S5 必须在此显式覆盖
# Vite 生产构建先读 .env 再读 .env.production。.env 里这四个是本地 dev 端口
# （5182/5189/5190/5191），若不在此覆盖，线上门户的 iframe 会指向
# http://localhost:xxxx —— 即访问者自己的电脑，页面必然全白。
VITE_FE_S2=/modules/s2
VITE_FE_S3=/modules/s3
VITE_FE_S4=/modules/s4
VITE_FE_S5=/modules/s5
