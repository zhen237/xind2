      "验收标准": "安装牢固，接线端子防护罩完好。",
      "适用设备类型": "power"
    },
    {
      "序号": 2,
      "工序名称": "电池组安装",
      "工艺要求": "蓄电池按极性串联连接，铜排连接面涂抹导电膏。电池架与地面间加绝缘垫。",
      "验收标准": "电池组总电压 = 单体数 × 2.23V，浮充电正常。",
      "适用设备类型": "power"
    },
    {
      "序号": 3,
      "工序名称": "交直流通电测试",
      "工艺要求": "先交流上电，确认整流模块输出正常后再接入直流负载，逐路合闸。",
      "验收标准": "交流输入电压 380V±10%，直流输出 -48V±2V。",
      "适用设备类型": "power"
    },
    {
      "序号": 4,
      "工序名称": "电源接地",
      "工艺要求": "电源机架接地接至机房接地排，接地线 ≥ 16mm²，接地电阻 ≤ 5Ω。",
      "验收标准": "接地电阻测试合格。",
      "适用设备类型": "power"
    },
    {
      "序号": 5,
      "工序名称": "传输设备安装",
      "工艺要求": "PTN/OTN 设备安装于机柜指定位置，光口侧朝机柜正面，便于维护。",
      "验收标准": "安装稳固，槽位正确。",
      "适用设备类型": "transmission"
    },
    {
      "序号": 6,
      "工序名称": "光模块安装",
      "工艺要求": "SFP+/SFP28 模块安装前检查金手指，插入后锁紧拉环。不同速率模块勿混插。",
      "验收标准": "模块到位，端口指示灯正常。",
      "适用设备类型": "transmission"
    },
    {
      "序号": 7,
      "工序名称": "光纤跳接",
      "工艺要求": "主干光缆熔接至 ODF 端子，再用光纤跳线连接 ODF ↔ PTN。跳线长度 ≤ 15m。",
      "验收标准": "光功率接收值在灵敏度范围内，误码率 = 0。",
      "适用设备类型": "transmission"
    },
    {
      "序号": 8,
      "工序名称": "传输链路联调",
      "工艺要求": "逐端口打环测试，确认对端设备可达。配置 VLAN / QoS 按设计值。",
      "验收标准": "所有业务端口 Ping 通，丢包率 = 0，时延 < 1ms。",
      "适用设备类型": "transmission"
    },
    {
      "序号": 9,
      "工序名称": "RRU 安装固定",
      "工艺要求": "RRU 安装于抱杆或挂墙支架上，散热面朝外，安装高度距天线 ≤ 3m。",
