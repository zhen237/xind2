    {
      "序号": 1,
      "工序名称": "电源设备安装",
      "工艺要求": "嵌入式电源/配电箱安装于机柜底部或指定位置，交流输入端需安装防雷模块。",
      "验收标准": "安装牢固，接线端子防护罩完好。",
      "适用设备类型": "power"
    },
    {
      "序号": 2,
      "工序名称": "电池组安装",
      "工艺要求": "蓄电池按极性串联连接，铜排连接面涂抹导电膏。电池架与地面间加绝缘垫。",
      "验收标准": "电池组总电压 = 单体数 × 2.23V，浮充电正常。",
      "适用设备类型": "power"
    },
    {
      "序号": 3,
      "工序名称": "交直流通电测试",
      "工艺要求": "先交流上电，确认整流模块输出正常后再接入直流负载，逐路合闸。",
      "验收标准": "交流输入电压 380V±10%，直流输出 -48V±2V。",
      "适用设备类型": "power"
    },
    {
      "序号": 4,
      "工序名称": "电源接地",
      "工艺要求": "电源机架接地接至机房接地排，接地线 ≥ 16mm²，接地电阻 ≤ 5Ω。",
      "验收标准": "接地电阻测试合格。",
      "适用设备类型": "power"
    },
    {
      "序号": 5,
      "工序名称": "机柜就位与固定",
      "工艺要求": "机柜按设计位置就位，使用膨胀螺栓固定于地面，顶部使用上走线架连接加固。",
      "验收标准": "机柜垂直度偏差 ≤ 3mm/m，前后门开闭正常。",
      "适用设备类型": "rack"
    },
    {
      "序号": 6,
      "工序名称": "机柜接地",
      "工艺要求": "机柜接地铜排通过 16mm² 黄绿地线连接至机房接地排。",
      "验收标准": "接地电阻 ≤ 5Ω。",
      "适用设备类型": "rack"
    },
    {
      "序号": 7,
      "工序名称": "微站 RRU 杆装",
      "工艺要求": "RRU 抱杆安装于灯杆/监控杆中段，散热面朝向开阔方向。",
      "验收标准": "安装牢固，防水接头拧紧。",
      "适用设备类型": "micro_rru"
    },
    {
      "序号": 8,
      "工序名称": "微站 RRU 光电混合缆连接",
      "工艺要求": "光电混合缆接头清洁后对接，光纤 + 电源一体化。",
      "验收标准": "光功率正常，PoE 供电稳定。",
      "适用设备类型": "micro_rru"
    },
    {
      "序号": 9,
      "工序名称": "微站信号覆盖测试",
      "工艺要求": "使用路测软件在覆盖区域内测试 RSRP / SINR。",
      "验收标准": "覆盖区内 RSRP ≥ -110 dBm, SINR ≥ 0 dB。",
      "适用设备类型": "micro_rru"
    },
    {
      "序号": 10,
      "工序名称": "天线吊装",
      "工艺要求": "使用专用吊装工具，吊装时天线面朝下，禁止碰撞天线罩。风速>6级停止吊装。",
