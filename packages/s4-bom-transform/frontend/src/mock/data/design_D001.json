  "cables": {
    "fiber_optic": {
      "description": "BBU ↔ RRU/AAU 光纤连接，每个扇区 2 芯（主备），水平距离由坐标计算",
      "notes": "光纤长度 = 水平距离 × 1.2（预留弯曲余量）"
    },
    "rf_jumper": {
      "description": "RRU ↔ 天线跳线，每根 3m 标准",
      "notes": "64T64R AAU 自带 eCPRI 接口，无独立射频跳线"
    },
    "power_cable": {
      "description": "配电箱 → 电源系统，配电箱 → BBU/RRU；主备双路由",
      "notes": "按设备额定功率计算线径，长度由坐标距离 + 竖井高度"
    },
    "ground_cable": {
      "description": "馈线接地、机柜接地、天馈接地",
      "notes": "每 RRU/AAU 1 根，机柜 2 根"
    }
  }
