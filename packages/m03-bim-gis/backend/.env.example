# M03 BIM+GIS三维设计服务 - 环境变量配置

# 服务器配置
SERVER_PORT=8083

# 数据库配置
MYSQL_URL=jdbc:mysql://localhost:3306/comm_platform?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# JWT配置
JWT_SECRET=your-strong-secret-key-minimum-32-characters
JWT_EXPIRATION=604800000
