# ============================================================
# M03 BIM+GIS 前端环境变量
# 复制此文件为 .env 并填入实际值
# ============================================================

# Cesium Ion Token (可选 — 使用天地图时不需要)
VITE_CESIUM_ION_TOKEN=

# 天地图密钥 (必填 — 前往 https://console.tianditu.gov.cn/ 申请)
VITE_TIANDITU_TOKEN=

# API 基础路径
VITE_API_BASE_URL=/api

# 生产环境允许的 postMessage 来源（逗号分隔）
# 示例: VITE_ALLOWED_ORIGINS=https://portal.example.com,https://admin.example.com
VITE_ALLOWED_ORIGINS=
