<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.comm</groupId>
    <artifactId>comm-platform-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>comm-platform-parent</name>
    <description>通信基建数智化全流程平台 - 父POM</description>

    <modules>
        <module>packages/shared/backend</module>
        <module>packages/m01-auth/backend</module>
        <module>packages/m03-bim-gis/backend</module>
        <module>packages/m04-delivery/backend</module>
        <module>packages/m05-twin-ops/backend</module>
        <module>packages/screen/backend</module>
        <!-- 新赛题模块（骨架已创建，待各负责人填充业务代码） -->
        <module>packages/s2-cad-fusion/backend</module>
        <module>packages/s3-review-engine/backend</module>
        <module>packages/s4-bom-transform/backend</module>
        <!--
          packages/s5-construction-monitor/backend 是 **Node 后端**（node src/server.js，端口 8091），
          目录下没有 pom.xml。此处曾把它列为一个 Maven 模块，导致任何从仓库根发起的
          `mvn -pl <任意模块> -am ...` 都会在解析聚合 POM 阶段直接失败：
            Child module .../packages/s5-construction-monitor/backend/pom.xml ... does not exist
          （CI 的 test 作业正是这样调用的，故该门禁在修好前不可能通过。）
          如后续要给它加 Java 侧模块，请新建 packages/s5-construction-monitor/<java模块>/backend
          并在此登记，不要直接复用这个 Node 目录。
        -->
        <!-- <module>packages/s5-construction-monitor/backend</module> -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.1.10</spring-boot.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <jjwt.version>0.11.5</jjwt.version>
        <lombok.version>1.18.30</lombok.version>
        <spring-security.version>6.2.1</spring-security.version>
        <mysql.version>8.0.33</mysql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <optional>true</optional>
            </dependency>

            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <dependency>
                <groupId>com.comm</groupId>
                <artifactId>shared-backend</artifactId>
                <version>1.0.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
